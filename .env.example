# ══════════════════════════════════════════
# LuxSalon SaaS v2 — Environment Variables
# Copy to .env.local — NEVER commit secrets
# ══════════════════════════════════════════

# ─── Supabase ─────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ─── App ──────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
APP_VERSION=2.0.0

# ─── Stripe ───────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── WhatsApp Business Cloud API ──────────
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-business-account-id
WHATSAPP_ACCESS_TOKEN=your-permanent-access-token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-random-verify-token
WHATSAPP_API_VERSION=v17.0

# ─── Firebase (Push Notifications) ────────
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"

# ─── Upstash Redis ────────────────────────
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# ─── Google Calendar ──────────────────────
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ─── Resend Email ─────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@yoursalon.com
EMAIL_FROM_NAME=LuxSalon

# ─── Twilio SMS ───────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ─── 2FA / TOTP ───────────────────────────
TOTP_ISSUER=LuxSalon
ENCRYPTION_KEY=generate-with-openssl-rand-hex-32

# ─── Security ─────────────────────────────
CSRF_SECRET=generate-with-openssl-rand-hex-32
JWT_SECRET=generate-with-openssl-rand-hex-64
JWT_EXPIRY=7d

# ─── Sentry ───────────────────────────────
SENTRY_DSN=https://your-key@sentry.io/project-id
NEXT_PUBLIC_SENTRY_DSN=https://your-key@sentry.io/project-id

# ─── Rate Limiting ────────────────────────
RATE_LIMIT_MAX_PUBLIC=100
RATE_LIMIT_MAX_AUTH=500

# ─── Business Defaults ────────────────────
DEFAULT_TIMEZONE=Asia/Karachi
DEFAULT_CURRENCY=PKR
DEFAULT_TAX_RATE=0.17
REMINDER_ADVANCE_HOURS=24
